import sys

def solve():
    input = sys.stdin.read
    data = input().split()
    if not data:
        return
    
    t = int(data[0])
    results = []
    
    for i in range(1, t + 1):
        rating = int(data[i])
        if rating >= 1900:
            results.append("Division 1")
        elif rating >= 1600:
            results.append("Division 2")
        elif rating >= 1400:
            results.append("Division 3")
        else:
            results.append("Division 4")
            
    print('\n'.join(results))

if __name__ == '__main__':
    solve()
